{
  "name": "writer-app",
  "version": "1.3.1",
  "private": true,
  "description": "Локальный кабинет писателя: главы, персонажи, мир, таймлайн и облако связей.",
  "author": {
    "name": "Taiga Develop",
    "email": "taigadevelop@ya.ru"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "prisma db push --skip-generate",
    "dist:win": "next build --webpack && node scripts/prepare-dist.mjs && electron-builder --win --x64 --dir && node scripts/inject-server.mjs && electron-builder --win --x64 --prepackaged dist/win-unpacked"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "docx": "^9.1.1",
    "electron-updater": "^6.8.9",
    "jimp": "^0.22.12",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.3",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "ru.writersvault.desktop",
    "productName": "Writer's Vault",
    "artifactName": "Writers-Vault-Setup-${version}.${ext}",
    "copyright": "© 2026 Taiga Develop",
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "Taigain",
      "repo": "writers-vault",
      "releaseType": "draft"
    },
    "electronLanguages": [
      "en",
      "ru"
    ],
    "files": [
      "electron/**/*",
      "package.json"
    ]
  }
}
