generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Book {
  id              String            @id @default(cuid())
  title           String
  coverBase64     String?
  annotation      String            @default("")
  synopsis        String            @default("")
  structure       String?
  exportMeta      Boolean           @default(true)
  seriesId        String?
  series          Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  chapters        Chapter[]
  characters      Character[]
  locations       Location[]
  timelineEvents  TimelineEvent[]
  loreEntries     LoreEntry[]
  notes           Note[]
  status          String          @default("active")
  storylines      Storyline[]
  plotBeats       PlotBeat[]
  dict DictEntry[]
}

model Note {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title       String   @default("")
  text        String   @default("")
  kind        String   @default("other")
  done        Boolean  @default(false)
  imageBase64 String?
  posX        Int?
  posY        Int?
  createdAt   DateTime @default(now())
}

model Character {
  id          String              @id @default(cuid())
  name        String
  role        String              @default("secondary")
  bio         String              @default("")
  appearance  String              @default("")
  personality String              @default("")
  decisions   String              @default("")
  arc         String              @default("")
  aliases     String              @default("")
  portraitBase64 String?
  bookId      String
  book        Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mentions    ChapterMention[]
  relations   CharacterRelation[] @relation("CharacterRelations")
  relatedIn   CharacterRelation[] @relation("RelatedRelations")
  eventLinks  EventCharacter[]
  beatLinks   BeatCharacter[]
}

model CharacterRelation {
  id          String    @id @default(cuid())
  characterId String
  relatedId   String
  note        String    @default("")
  character   Character @relation("CharacterRelations", fields: [characterId], references: [id], onDelete: Cascade)
  related     Character @relation("RelatedRelations", fields: [relatedId], references: [id], onDelete: Cascade)
}

model EventCharacter {
  id          String        @id @default(cuid())
  eventId     String
  characterId String
  event       TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([eventId, characterId])
}

model EventMention {
  id        String        @id @default(cuid())
  chapterId String
  eventId   String
  chapter   Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([chapterId, eventId])
}

model Location {
  id          String           @id @default(cuid())
  name        String
  desc        String           @default("")
  imageBase64 String?
  bookId      String
  book        Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mentions    ChapterMention[]
}

model Chapter {
  id             String            @id @default(cuid())
  title          String
  content        String            @default("")
  order          Int
  bookId         String
  book           Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mentions       ChapterMention[]
  eventMentions  EventMention[]
  timelinePins   TimelineEvent[]
  plotBeats       PlotBeat[]
  actName String?
}

model ChapterMention {
  id          String     @id @default(cuid())
  chapterId   String
  characterId String?
  locationId  String?
  snippet     String     @default("")
  chapter     Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  location    Location?  @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id           String           @id @default(cuid())
  dateType     String           @default("calendar")
  date         String           @default("")
  bookYear     Int?
  bookDay      Int?
  description  String
  tag          String?
  summary      String           @default("")
  createdAt    DateTime         @default(now())
  bookId       String
  book         Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId    String?
  chapter      Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  participants EventCharacter[]
  plotBeats       PlotBeat[]
  mentions     EventMention[]
}

model LoreEntry {
  id        String   @id @default(cuid())
  text      String
  tags      String
  imageBase64 String?
  createdAt DateTime @default(now())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Series {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  books     Book[]
}

model PlotBeat {
  id         String          @id @default(cuid())
  bookId     String?
  book       Book?           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lineId     String?
  title      String          @default("")
  summary    String          @default("")
  order      Int             @default(0)
  chapterId  String?
  chapter    Chapter?        @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  eventId    String?
  event      TimelineEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  characters BeatCharacter[]
  lines      BeatLine[]
}

model BeatLine {
  id     String    @id @default(cuid())
  beatId String
  beat   PlotBeat  @relation(fields: [beatId], references: [id], onDelete: Cascade)
  lineId String
  line   Storyline @relation(fields: [lineId], references: [id], onDelete: Cascade)
  order  Int       @default(0)

  @@unique([beatId, lineId])
}

model Storyline {
  id     String     @id @default(cuid())
  bookId String
  book   Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name   String
  order  Int        @default(0)
  beats  BeatLine[]
}

model BeatCharacter {
  id          String    @id @default(cuid())
  beatId      String
  beat        PlotBeat  @relation(fields: [beatId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([beatId, characterId])
}

model DictEntry {
  id      String @id @default(cuid())
  bookId  String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  key     String
  word    String
  meaning String @default("")
  forms   String @default("[]")

  @@unique([bookId, key])
}