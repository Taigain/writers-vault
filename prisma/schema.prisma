generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Book {
  id              String            @id @default(cuid())
  title           String
  coverBase64     String?
  annotation      String            @default("")
  synopsis        String            @default("")
  structure       String?
  exportMeta      Boolean           @default(true)
  exportTitle      Boolean          @default(false)
  exportAnnotation Boolean          @default(false)
  exportSynopsis   Boolean          @default(false)
  seriesId        String?
  series          Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  chapters        Chapter[]
  characters      Character[]
  locations       Location[]
  timelineEvents  TimelineEvent[]
  loreEntries     LoreEntry[]
  notes           Note[]
  status          String          @default("active")
  storylines      Storyline[]
  plotBeats       PlotBeat[]
  genre           String          @default("")
  spineColor      String          @default("")
  spineStyle      String          @default("tome")
  dictGroups DictGroup[]
  dict DictEntry[]
  boardH Int?
  authorName   String?
  exportAuthor Boolean @default(false)
  snapshots BookSnapshot[]
  cloudBackup Boolean @default(true)
}

model DictGroup {
  id      String      @id @default(cuid())
  bookId  String
  book    Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name    String
  slug    String
  color   String      @default("")
  entries DictEntry[]

  @@unique([bookId, slug])
}

model IdeaNote {
  id        String   @id @default(cuid())
  text      String   @default("")
  x         Int      @default(40)
  y         Int      @default(40)
  createdAt DateTime @default(now())
  color     String   @default("")
}

model Note {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title       String   @default("")
  text        String   @default("")
  kind        String   @default("other")
  done        Boolean  @default(false)
  imageBase64 String?
  posX        Int?
  posY        Int?
  createdAt   DateTime @default(now())
}

model Character {
  id          String              @id @default(cuid())
  name        String
  role        String              @default("secondary")
  bio         String              @default("")
  appearance  String              @default("")
  personality String              @default("")
  decisions   String              @default("")
  arc         String              @default("")
  aliases     String              @default("")
  portraitBase64 String?
  bookId      String
  book        Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mentions    ChapterMention[]
  scenes       SceneCharacter[]
  relations   CharacterRelation[] @relation("CharacterRelations")
  relatedIn   CharacterRelation[] @relation("RelatedRelations")
  eventLinks  EventCharacter[]
  beatLinks   BeatCharacter[]
  age         String @default("")
  gender      String @default("")
  birth       String @default("")
  race        String @default("")
  country     String @default("")
  language    String @default("")
  archetype   String @default("")
  goal        String @default("")
  conflict    String @default("")
  trauma      String @default("")
  obsession   String @default("")
  strengths   String @default("")
  weaknesses  String @default("")
  height      String @default("")
  weight      String @default("")
  build       String @default("")
  eyes        String @default("")
  hair        String @default("")
  clothing    String @default("")
  posture     String @default("")
  voice       String @default("")
  boardX Int?
  boardY Int?  
  seriesCharId String?
  seriesChar   SeriesChar? @relation(fields: [seriesCharId], references: [id], onDelete: SetNull)
}

model CharacterRelation {
  id          String    @id @default(cuid())
  characterId String
  relatedId   String
  note        String    @default("")
  character   Character @relation("CharacterRelations", fields: [characterId], references: [id], onDelete: Cascade)
  related     Character @relation("RelatedRelations", fields: [relatedId], references: [id], onDelete: Cascade)
  kind String @default("mutual")
}

model EventCharacter {
  id          String        @id @default(cuid())
  eventId     String
  characterId String
  event       TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([eventId, characterId])
}

model EventMention {
  id        String        @id @default(cuid())
  chapterId String
  eventId   String
  chapter   Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pos       Int?

  @@unique([chapterId, eventId])
}

model Location {
  id          String           @id @default(cuid())
  name        String
  desc        String           @default("")
  imageBase64 String?
  bookId      String
  book        Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mentions    ChapterMention[]
}

model Chapter {
  id             String            @id @default(cuid())
  title          String
  content        String            @default("")
  order          Int
  bookId         String
  book           Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mentions       ChapterMention[]
  scenes       Scene[]
  eventMentions  EventMention[]
  timelinePins   TimelineEvent[]
  plotBeats       PlotBeat[]
  actName String?
}

model ChapterMention {
  id          String     @id @default(cuid())
  chapterId   String
  characterId String?
  locationId  String?
  pos Int?
  note String?
  snippet     String     @default("")
  chapter     Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  location    Location?  @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id           String           @id @default(cuid())
  dateType     String           @default("calendar")
  date         String           @default("")
  bookYear     Int?
  bookDay      Int?
  description  String
  tag          String?
  summary      String           @default("")
  createdAt    DateTime         @default(now())
  bookId       String
  book         Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId    String?
  chapter      Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  participants EventCharacter[]
  plotBeats       PlotBeat[]
  mentions     EventMention[]
}

model LoreEntry {
  id        String   @id @default(cuid())
  text      String
  tags      String
  imageBase64 String?
  createdAt DateTime @default(now())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Series {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  books     Book[]
  cast SeriesChar[]
}

model PlotBeat {
  id         String          @id @default(cuid())
  bookId     String?
  book       Book?           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lineId     String?
  title      String          @default("")
  summary    String          @default("")
  order      Int             @default(0)
  chapterId  String?
  chapter    Chapter?        @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  eventId    String?
  event      TimelineEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  characters BeatCharacter[]
  lines      BeatLine[]
  canvasX    Int?
  canvasY    Int?
  linksA     BeatLink[] @relation("BeatLinkA")
  linksB     BeatLink[] @relation("BeatLinkB")
}

model BeatLine {
  id     String    @id @default(cuid())
  beatId String
  beat   PlotBeat  @relation(fields: [beatId], references: [id], onDelete: Cascade)
  lineId String
  line   Storyline @relation(fields: [lineId], references: [id], onDelete: Cascade)
  order  Int       @default(0)

  @@unique([beatId, lineId])
}

model Storyline {
  id     String     @id @default(cuid())
  bookId String
  book   Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name   String
  order  Int        @default(0)
  beats  BeatLine[]
}

model BeatCharacter {
  id          String    @id @default(cuid())
  beatId      String
  beat        PlotBeat  @relation(fields: [beatId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([beatId, characterId])
}

model BeatLink {
  id   String   @id @default(cuid())
  aId  String
  bId  String
  a    PlotBeat @relation("BeatLinkA", fields: [aId], references: [id], onDelete: Cascade)
  b    PlotBeat @relation("BeatLinkB", fields: [bId], references: [id], onDelete: Cascade)

  @@unique([aId, bId])
}

model DictEntry {
  id      String @id @default(cuid())
  bookId  String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  key     String
  word    String
  meaning String @default("")
  forms   String @default("[]")
  groupId  String?
  group    DictGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([bookId, key])
}

model Scene {
  id         String           @id @default(cuid())
  chapterId  String
  chapter    Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order      Int              @default(0)
  title      String           @default("")
  start      Int              @default(0)
  end        Int              @default(0)
  characters SceneCharacter[]
  images    SceneImage[]
}

model SceneCharacter {
  id          String    @id @default(cuid())
  sceneId     String
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
}

model License {
  id          String    @id @default("local")
  keyText     String    @default("")
  proUntil    DateTime?
  trialUsedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model AuthorProfile {
  id        String   @id @default("local")
  name      String   @default("")
  penNames  String   @default("")
  genres    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeriesChar {
  id        String           @id @default(cuid())
  seriesId  String
  series    Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name      String
  canonId   String?
  doubles   Character[]
  relsA     SeriesRelation[] @relation("SeriesRelA")
  relsB     SeriesRelation[] @relation("SeriesRelB")
  createdAt DateTime         @default(now())

  @@unique([seriesId, name])
}

model SeriesRelation {
  id   String     @id @default(cuid())
  aId  String
  bId  String
  note String     @default("")
  kind String     @default("mutual")
  a    SeriesChar @relation("SeriesRelA", fields: [aId], references: [id], onDelete: Cascade)
  b    SeriesChar @relation("SeriesRelB", fields: [bId], references: [id], onDelete: Cascade)

  @@unique([aId, bId])
}

model BookSnapshot {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  label     String   @default("")
  payload   String

  @@index([bookId, createdAt])
}

model CloudTarget {
  id        String    @id @default(cuid())
  provider  String
  name      String
  rootPath  String
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  lastStatus String   @default("")
  createdAt DateTime  @default(now())
}

model SceneImage {
  id        String   @id @default(cuid())
  sceneId   String
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  bookId    String
  caption   String   @default("")
  align     String   @default("center")
  widthPct  Int      @default(80)
  base64    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sceneId])
}